# ── Postgres ──────────────────────────────────────────────────────────────────
# asyncpg-compatible DSN. Used for PostGIS (live data), pgvector (embeddings/RAG),
# and schema bootstrap.
POSTGRES_DSN=postgresql://sim:sim@localhost:5433/sim

# ── Neo4j ─────────────────────────────────────────────────────────────────────
# Dependency graph and simulation-event overlays. Required for /query and /admin.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Neo4j 5 requires passwords ≥ 8 characters (compose default: simsimsim).
NEO4J_PASSWORD=simsimsim

# ── LLM backend ───────────────────────────────────────────────────────────────
# Selects the inference client: openai | llamastack | fake
# - openai:     any OpenAI-compatible endpoint (OpenAI, vLLM, Llama Stack /v1)
# - llamastack: Llama Stack SDK path (requires llama-stack-client installed)
# - fake:       FakeLLMClient for tests / CI / dev without a GPU
LLM_BACKEND=openai

# Base URL for the OpenAI-compatible inference endpoint.
# OpenAI (default):   https://api.openai.com/v1
# vLLM (local):       http://localhost:8080/v1
# Llama Stack /v1:    http://localhost:8321/v1
LLM_BASE_URL=https://api.openai.com/v1

# API key for the inference endpoint.
# For self-hosted vLLM or Llama Stack, any non-empty string works.
OPENAI_API_KEY=sk-...

# ── Model IDs ─────────────────────────────────────────────────────────────────
# Must match what is available at LLM_BASE_URL.
GENERATION_MODEL_ID=gpt-4o-mini
EMBEDDING_MODEL_ID=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# For vLLM / Llama Stack with a local model:
# GENERATION_MODEL_ID=RedHatAI/Meta-Llama-3.1-8B-Instruct-FP8
# EMBEDDING_MODEL_ID=all-MiniLM-L6-v2
# EMBEDDING_DIMENSION=384

# ── Domains ───────────────────────────────────────────────────────────────────
# Comma-separated domain packages to load from domain/<name>/.
# Controls which adapters (and optional domain solvers) are registered.
# Known ids: aviation, shipping
ENABLED_DOMAINS=aviation,shipping
